!?FU(OnDetermineMonInfoDlgUpgrade);
!#VA(monType:x) (upgType:x) (town:x) (hero:x);

; Need a real hero and artifact 283 on the body (backpack does not count).
!!FU&(hero)<0:E;
!!FU(Art283_IsEquipped):P(hero)/283/?y1;
!!FU&y1=0:E;

; Copy source type to a normal local variable for old receiver syntax.
!!VRy20:S(monType);

; Creature level (MA:L is 0..6 = levels 1..7).
!!MA:Ly20/?y2;
!!FU&y2<0:E;
!!FU&y2>6:E;

; ------------------------------------------------------------
; Detect source upgrade stage.
; First try its native town's standard base / upgraded dwelling entries.
; ------------------------------------------------------------
!!VRy6:S-1;
!!MA:Oy20/?y3;
!!if&y3>=0/y3<=8;
  !!UN:Ty3/y2/0/?y4;
  !!UN:Ty3/y2/1/?y5;
  !!VRy6&y20=y4:S0;
  !!VRy6&y20=y5:S1;
!!en;

; If it is not a normal base/upgraded unit, check all Third Upgrade tables.
; This also works if a custom 3rd-upgrade creature has an unusual MA:O value.
!!if&y6=-1;
  !!FU(Art283_GetThird):P0/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P1/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P2/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P3/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P4/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P5/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P6/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P7/y2/?y7; !!VRy6&y20=y7:S2;
  !!FU(Art283_GetThird):P8/y2/?y7; !!VRy6&y20=y7:S2;
!!en;

; Fourth-stage units are sparse: each town has only two chains.
!!if&y6=-1;
  !!FU(Art283_GetFourth):P0/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P1/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P2/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P3/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P4/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P5/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P6/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P7/y2/?y7; !!VRy6&y20=y7:S3;
  !!FU(Art283_GetFourth):P8/y2/?y7; !!VRy6&y20=y7:S3;
!!en;
!!FU&y6<0:E;

; Hero's native faction. Base heroes 0..143 are 16 heroes per faction.
; Campaign/special heroes 144..155 are mapped explicitly below.
!!FU(Art283_HeroTown):P(hero)/?y9;
!!FU&y9<0:E;
!!FU&y9>8:E;

; ------------------------------------------------------------
; Choose same level + same stage in hero's faction.
; Base/normal upgrade are read dynamically from the town tables so this stays
; compatible with mods that alter ordinary dwelling creatures.
; ------------------------------------------------------------
!!VRy10:S-1;
!!UN&y6=0:Ty9/y2/0/?y10;
!!UN&y6=1:Ty9/y2/1/?y10;
!!FU(Art283_GetThird)&y6=2:Py9/y2/?y10;
!!FU(Art283_GetFourth)&y6=3:Py9/y2/?y10;

; Not every faction has a fourth-stage unit at every level. In that case,
; preserve the creature level and use that faction's highest universal stage
; (the Third Upgrade Mod unit) rather than refusing the conversion.
!!if&y6=3/y10<0;
  !!FU(Art283_GetThird):Py9/y2/?y10;
!!en;

!!FU&y10<0:E;
; If already exactly the target creature, preserve the game's native decision.
!!FU&y10=y20:E;

; Override the monster-info upgrade target.
!!VR(upgType):Sy10;


