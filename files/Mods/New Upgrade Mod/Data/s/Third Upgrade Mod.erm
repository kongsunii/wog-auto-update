; --------------------------------------------------------------------------
; Check whether artifact 256 is equipped by either battle hero.
; BH0/BH1 are used directly so the effect is global to the whole battlefield,
; regardless of which side is currently dealing damage.
; --------------------------------------------------------------------------
!!VRy66:S0;
!!BH0:N?y60;
!!BH1:N?y61;

!!if&y60>=0;
  !!HEy60:A2/256/?y62/?y63;
  !!VRy66&y63>0:S1;
!!en;

!!if&y66=0/y61>=0;
  !!HEy61:A2/256/?y64/?y65;
  !!VRy66&y65>0:S1;
!!en;

!!FU&y66=0:E;

; --------------------------------------------------------------------------
; Determine creature factions dynamically. This also covers custom 3rd/4th
; upgrades as long as their MA:O faction is configured as Inferno (3).
; --------------------------------------------------------------------------
!!MA&y10>=0:Oy10/?y70;
!!MA&y20>=0:Oy20/?y71;

; Inferno attacker: +30% final damage.
!!if&y70=3;
  !!VRy72:Sx4;
  !!VRy72:*13;
  !!VRy72::10;
  !!VRx4:Sy72;
!!en;

; Inferno defender: -30% damage received.
!!if&y71=3;
