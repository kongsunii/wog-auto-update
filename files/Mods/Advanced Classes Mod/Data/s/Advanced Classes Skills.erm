  !!SN:W^Magic_Damage_Counter_Hero_%Y1^/?y14;
  !!SN:W^Magic_Damage_Counter_Hero_Temp_%Y1^/?y15;

  !!VRy12:-y10;                         [Substract temp value from real value]
