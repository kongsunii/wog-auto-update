!#SN:W^Critical_Sorcery_Mod^/1;         [Critical Sorcery Mod Active]
!#TM51:S1/999/7/255;


*-------------------------------------------------------------------------------
!?MR1&1000;                             [Magic Res Trigger for non Crit]

!!FU:E;                                 [Test]
!!BG:A?y1;                              [Aktion in y1]
!!FU&y1<>1:E;
!!BG:S?y2;                              [Falls Aktion ein Cast ist dann Speichere Spellnummer in y2]
!!FU&y2<=9|y2>69:E;
!!MR:F?y3;                              [Speichere DMG in y3]
!!BG:H?y4;                              [Number of a hero owner (-1=no hero)   in y4]
!!FU&y4<0:E;

!!FU(H3_Calc_Normal_Spell_Damage):Py4/?y99/?y98/1/y2/0; [Pass Hero Number and Give Back Damage in y99 and Extra Damage Option and Spell Number]

!!VRy3:*y99:100;
*!MR:Fy3; Test                              [apply new damage]

*fix for Landmine and Firewall with Set Bonus
!?MR1&1000;                             [Magic Res Trigger]

!!FU:E;                                 [Test]
!!BG:Q?y4;
!!VRy4:-1*-1;
!!BA:Hy4/?y4;
!!FU&y4<=0:E;                           [Exit if no enemy Hero]

!!MR:S?y2;                              [Falls Aktion ein Cast ist dann Speichere Spellnummer in y2]
!!if|y2=11/y2=13;                      [If Landmine or Firewall]
!!FU(H3_Calc_Normal_Spell_Damage):Py4/?y99/?y98/1/y2/0; [Pass Hero Number and Give Back Damage in y99 and Extra Damage Option and Spell Number]
!!MR:F?y3;                              [Speichere DMG in y3]
!!VRy3:*y99:100;
*!IF:M^New Damage is %Y3 and y99 is %Y99 und Spell is %Y2^;
*!MR:Fy3;                            [apply new damage]
!!en;

*-------------------------------------------------------------------------------
!?MR1&1000;                             [Magic Res Trigger for Crit]

!!BG:H?y1;                              [Determine if AI controlls Hero]
!!HEy1:O?y1;
!!OW:Iy1/?y1;
!!FU&y1=1:E;

!!BG:A?y1;                              [Aktion in y1]
!!FU&y1<>1:E;

!!BG:Q?y4;
!!BA:Hy4/?y4;
!!FU&y4<=0:E;                           [Exit if no Hero]

!!BG:Q?y30;
!!VRy30:-1 *-1;
!!BA:Hy30/?y31;                         [Enemy Hero for resistance Calculation]

!!BG:S?y2;                              [Falls Aktion ein Cast ist dann Speichere 1 in y2]
!!FU&y2<=9|y2>69:E;

!!MR:F?y3;                              [Speichere DMG in y3]
